# Which chain the product is pointed at. Unset falls back to devnet, never mainnet: an
# unset variable must fail toward "this is not real money".
NEXT_PUBLIC_SOLANA_CLUSTER=devnet

# Optional: a paid RPC. Leave unset to use the public endpoint for the cluster above.
NEXT_PUBLIC_SOLANA_RPC=

# The canonical origin. Relative OG images and canonical URLs resolve against it, so an
# unset value points every share card at localhost.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Where the local cache lives. The chain is the memory; this file is only an index.
WEBGOLD_DB_PATH=var/webgold.db
