# ── Which chain the product is pointed at ─────────────────────────────────────────────────
# Unset falls back to devnet, never mainnet: an unset variable must fail toward "this is not
# real money". The cache file follows it: var/scrip.<cluster>.db.
NEXT_PUBLIC_SOLANA_CLUSTER=devnet

# An archival RPC (Helius, Triton) so any receipt signature resolves forever. Leave unset to
# use the public endpoint for the cluster above, which rate-limits hard.
NEXT_PUBLIC_SOLANA_RPC=

# The canonical origin. Share cards and the sign-in message resolve against it.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Devnet only: the six-decimal classic mint standing in for USDC. The devnet build of the
# program accepts any such mint; the mainnet build accepts Circle's USDC and nothing else.
NEXT_PUBLIC_DEVNET_USDC_MINT=

# ── Secrets ───────────────────────────────────────────────────────────────────────────────
# Signs the session cookie. REQUIRED in production. Generate: openssl rand -base64 32
SCRIP_SESSION_SECRET=

# Guards POST /api/maintenance (the multiplier watcher, the indexer, the measurement crank).
# Unset means the route refuses outright.
SCRIP_MAINTENANCE_SECRET=

# The keypair that pays to call measure_receipt at 7 and 30 days. A JSON array of bytes, or a
# path to one. Anyone may measure; this is only so the number exists without waiting.
SCRIP_CRANK_KEYPAIR=

# ── The keeper (npm run keeper) ───────────────────────────────────────────────────────────
# The keeper's keypair: pays fees, passes the slice through its own USDC account inside one
# atomic transaction, and is repaid from each Book's float. Needs SOL for fees and rent.
SCRIP_KEEPER_KEYPAIR=
# Hermes requires an API key since 2026-08-26. Without it the keeper can only use an on-chain
# price account somebody else keeps fresh, and on mainnet the SPYX one is not. Required.
PYTH_API_KEY=
PYTH_HERMES_URL=https://pyth.dourolabs.app/hermes
# Jupiter: keyless on lite-api.jup.ag; set a key to use api.jup.ag.
JUPITER_API_KEY=
# The keeper's health endpoint, which the app reads for "last sweep 3 min ago".
KEEPER_HEALTH_PORT=8787
# One url, or several separated by commas: every keeper this deployment runs reports for itself.
KEEPER_HEALTH_URL=http://localhost:8787/health
# How often the keeper polls, in seconds. It also subscribes to account changes.
KEEPER_POLL_SECONDS=15

# The devnet demo (scripts/devnet-demo.ts). Optional; defaults shown.
# DEMO_SLUG=demo
# DEMO_RATE_BPS=1000
# DEMO_KIND=person            # or org: the demo wallet is an organisation that also pays in stock
# DEVNET_RPC=https://api.devnet.solana.com

# The book on the front door: a handle whose owner turned on the public page. Real, live, optional.
# NEXT_PUBLIC_FRONT_BOOK=scrip

# Telegram: a message when a stub prints. Create a bot with @BotFather; set the webhook to <site>/api/notify/telegram/webhook with the secret.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_BOT_USERNAME=
# TELEGRAM_WEBHOOK_SECRET=

# Print every RPC call the server makes, with its method and how long it waited.
# SCRIP_RPC_DEBUG=1
# The gate's budget, when an endpoint allows more (or less) than the default for its host.
# SOLANA_RPC_RPS=100
# SOLANA_RPC_CONCURRENCY=32

# How long one register's live view is shared across readers, in milliseconds (default 3500).
# SCRIP_LIVE_MEMO_MS=3500
